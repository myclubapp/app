# Ohne dieses Flag brechen `npm ci` und `npm install` (npm 10 und 11) mit
# "Cannot read properties of null (reading 'children')" ab: package-lock.json
# enthält Peer-Konflikte, die nur mit legacy-peer-deps auflösbar sind – aktuell
# @angular/fire 20.x (Peer @angular/common ^20) und
# @fortawesome/angular-fontawesome 4.x (Peer @angular/core ^21) gegenüber
# Angular 22. Genau daran scheiterte der Hosting-Deploy in GitHub Actions von
# Juni bis September 2026, während es lokal (Flag in ~/.npmrc) funktionierte.
# Sobald AngularFire und angular-fontawesome für Angular 22 aktualisiert sind,
# kann das Flag entfernt und das Lockfile neu erzeugt werden.
legacy-peer-deps=true
