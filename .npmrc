# Das package-lock.json wurde mit legacy-peer-deps erzeugt. Ohne dieses Flag
# brechen `npm ci` und `npm install` (npm 10 und 11) beim Auflösen der
# Peer-Dependencies mit "Cannot read properties of null (reading 'children')"
# ab. Genau daran scheiterte der Hosting-Deploy in GitHub Actions von Juni bis
# September 2026, während es lokal (Flag in ~/.npmrc) funktionierte.
legacy-peer-deps=true
